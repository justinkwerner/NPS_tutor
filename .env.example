# ── LLM (NIM / OpenAI-compatible endpoint) ────────────────────────────────────
NIM_API_KEY=your_nim_api_key_here
NIM_BASE_URL=http://localhost:8000/v1
NIM_MODEL=nvidia/nemotron-3-super

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Priority: 1) NVIDIA API, 2) HF endpoint server, 3) local all-MiniLM-L6-v2

# Option 1: NVIDIA hosted embeddings (uses NIM_API_KEY above)
NVIDIA_EMBED_MODEL=nvidia/nv-embed-v1
# NIM_BASE_URL and NIM_API_KEY already set above

# Option 2: NPS HuggingFace embedding server (on-network only)
# EMBEDDING_SERVER_URL=http://trac-malenia.ern.nps.edu:8080/gpu5/embed

# Option 3: local fallback (all-MiniLM-L6-v2) — no key needed, used automatically

# ── Vectorstore ────────────────────────────────────────────────────────────────
# Path to the unified ChromaDB built by NPS_tutor.ipynb or scripts/build_vectorstore.py
CHROMA_DB_PATH=./databases/chroma_unified

# Path to the SATOPS ChromaDB (MAX GDS commands, satellite ops manuals)
SATOPS_CHROMA_DB_PATH=./databases/chroma_satops

# ── Database (Phase 2) ─────────────────────────────────────────────────────────
SQLITE_DB_PATH=./tutor.db
